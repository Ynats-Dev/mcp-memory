# Copier en .env puis remplir. Générer des secrets avec : openssl rand -hex 32
MCP_TOKEN=
# Connecteur claude.ai (exige une exposition Internet) : OAuth activé si les deux sont remplis.
# Usage local uniquement : laisser OAUTH_PASSWORD vide. MCP_PUBLIC_URL sert aussi à
# afficher l'adresse du serveur sur la page « Claude » de l'interface web.
# URL publique HTTPS (sans /mcp) par laquelle claude.ai joint le serveur
# ex. MCP_PUBLIC_URL=https://mcp.example.com
MCP_PUBLIC_URL=
# Mot de passe demandé sur la page « Autoriser l'accès » (12 caractères minimum)
OAUTH_PASSWORD=
# Facultatif : préfixes d'adresses de retour OAuth autorisés en plus de claude.ai / localhost
OAUTH_REDIRECTS=
# Interface web : le compte (identifiant + mot de passe) se crée à la première ouverture.
# IP d'écoute des ports 8765/8766 (0.0.0.0 = toutes les interfaces de la machine)
BIND_IP=0.0.0.0
# Facultatif : dépôt Git distant poussé après chaque modification (ex. Gogs)
# Sauvegarde chaque nuit (et à la demande, page Mémoire) vers un dépôt Git VIDE.
# Adresse sans identifiants ; le jeton passe par un en-tête, jamais dans .git/config.
GIT_REMOTE=
GIT_REMOTE_USER=
GIT_REMOTE_TOKEN=
SAUVEGARDE_HEURE=03:15
# Si le conteneur ne résout pas le nom du dépôt (DNS du réseau local seulement) :
GIT_REMOTE_HOST=
GIT_REMOTE_HOST_IP=
